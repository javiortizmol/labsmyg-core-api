#!/usr/bin/env sh
# Block push unless full quality gates pass.
# Intentionally NOT quality-fast — push runs the complete suite + global ≥90%.
# pip-audit runs when this push touches dependency lockfiles.
set -e
cd "$(git rev-parse --show-toplevel)"
make quality

audit_deps=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base main "$local_sha" 2>/dev/null || git merge-base master "$local_sha" 2>/dev/null || true)
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only $range | grep -qE '^(pyproject\.toml|uv\.lock)$'; then
    audit_deps=1
  fi
done

if [ "$audit_deps" = 1 ]; then
  uv run pip-audit --skip-editable
fi
