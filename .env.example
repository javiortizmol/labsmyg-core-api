# Copy to .env for local runs. Never commit real secrets.
# Docs: docs/local-compose.md · docs/local-aws-floci.md

# --- MySQL (make up) ---
# Host port 3307 avoids clashing with a local MySQL on 3306.
MYSQL_HOST_PORT=3307
MYSQL_USER=labsmyg
MYSQL_PASSWORD=labsmyg-local
MYSQL_ROOT_PASSWORD=labsmyg-root-local
# App (business) schema — ER docs/domain-er-model.md
DATABASE_URL=mysql+pymysql://labsmyg:labsmyg-local@localhost:3307/labsmyg
# Audit schema (write-only from app; separate logical DB on same server)
AUDIT_DATABASE_URL=mysql+pymysql://labsmyg:labsmyg-local@localhost:3307/labsmyg_audit
# From another Compose service on the same network:
# DATABASE_URL=mysql+pymysql://labsmyg:labsmyg-local@mysql:3306/labsmyg
# AUDIT_DATABASE_URL=mysql+pymysql://labsmyg:labsmyg-local@mysql:3306/labsmyg_audit

# --- Local AWS emulator (Floci) ---
# Start with DB: make up-aws   |   Floci only: make floci-up
# If Mandado (or another stack) already owns 4566, either reuse that Floci
# or: FLOCI_HOST_PORT=4567 make floci-up
# Console: http://localhost:${FLOCI_HOST_PORT:-4566}/_floci/ui
FLOCI_HOST_PORT=4566
# From the host:
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# Alias used by Compose for Floci's AWS_DEFAULT_REGION
AWS_REGION=us-east-1
# memory | hybrid | persistent | wal (Floci). hybrid is good for local dev.
FLOCI_STORAGE_MODE=hybrid

# From another Compose service on the same network, use:
# AWS_ENDPOINT_URL=http://floci:4566
